# SmartMart POS environment
# SQLite is the default. Use DB_PROVIDER=postgres to use Supabase instead.
DB_PROVIDER=sqlite
DATABASE_URL=file:../db/custom.db

# Supabase PostgreSQL (keep the URI private; never commit .env).
# Copy the complete Session Pooler URI from Supabase Project Settings → Database.
# DB_PROVIDER=postgres
# SUPABASE_DATABASE_URL=postgresql://postgres:ulhd5UfdG25jDA3E@db.fehrgjvfpowpgbziwymc.supabase.co:5432/postgres

